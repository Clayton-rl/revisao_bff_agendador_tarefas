# Stage 1: Builder
FROM maven:3-eclipse-temurin-21 AS builder

WORKDIR /build

COPY pom.xml /build/
COPY src /build/src

RUN mvn clean package -DskipTests

# Stage 2: Runtime
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

COPY --from=builder /build/target/revisao-bff-agendador-tarefas-0.0.1-SNAPSHOT.jar /app/app.jar

EXPOSE 8083

CMD ["java", "-jar", "/app/app.jar"]
